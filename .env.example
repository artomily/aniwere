# Frontend.
#
# Yang tanpa NEXT_PUBLIC_ hanya dibaca di server (route API dan panel
# attestation). Yang dengan NEXT_PUBLIC_ ikut ter-bundle ke browser, jadi
# jangan pernah menaruh secret di situ — semuanya di sini memang publik.

# ── Server ───────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# chainKey Sepolia di Creditcoin. BUKAN chain ID 11155111.
SOURCE_CHAIN_KEY=1

# ── Browser ──────────────────────────────────────────────────────────────
# Alamat AniWereASC hasil deploy. Selama kosong, UI menampilkan banner
# "sample data" di atas setiap halaman dan semua tombol on-chain mati.
# Itu memang yang diinginkan — jangan mengisinya dengan alamat karangan
# supaya bannernya hilang.
NEXT_PUBLIC_ASC_ADDRESS=

# AniWereProbe di Sepolia. Tanpa ini tombol "Probe my position" mati.
NEXT_PUBLIC_PROBE_ADDRESS=

# Dipakai wagmi kalau RPC publik kena rate limit saat demo.
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Aave V3 Pool di Sepolia. Terverifikasi lewat PoolAddressesProvider.getPool().
NEXT_PUBLIC_AAVE_POOL=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
