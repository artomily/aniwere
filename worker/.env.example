# ── Source chain ─────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# AniWereProbe hasil deploy contracts-sepolia.
PROBE_ADDRESS=

# Aave V3 Pool di Sepolia. Terverifikasi lewat PoolAddressesProvider.getPool(),
# lihat docs/ATTESTCOIN.md bagian 7. Harus identik dengan yang dipakai probe.
AAVE_POOL_SEPOLIA=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951

# ── Creditcoin ───────────────────────────────────────────────────────────
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031

# AniWereASC hasil deploy contracts-creditcoin.
ASC_ADDRESS=

# ── Attestcoin ───────────────────────────────────────────────────────────
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Identifier Sepolia di jaringan Creditcoin. INI BUKAN chain ID.
# Chain ID Sepolia 11155111, chain key-nya 1.
SOURCE_CHAIN_KEY=1

# Chain Info Precompile. Hanya dipakai `status` sebagai pembanding, dan
# gagalnya tidak menghentikan worker.
ATTESTCOIN_CHAIN_INFO=0x0000000000000000000000000000000000000FD3

# ── Wallet ───────────────────────────────────────────────────────────────
# Kurir, bukan otoritas. Kalau key ini bocor, yang bisa dilakukan penyerang
# hanya membayar gas untuk mengirim proof yang tetap harus sah.
# Perintah read-only (`status`, `prove`) jalan tanpa ini.
PRIVATE_KEY=

# ── Tuning ───────────────────────────────────────────────────────────────
# Angka yang dipakai contoh resmi Attestcoin: polling 15 detik, batas 20 menit.
ATTEST_POLL_MS=15000
ATTEST_TIMEOUT_MS=1200000

# Jeda antar putaran `watch`.
WATCH_INTERVAL_MS=30000
