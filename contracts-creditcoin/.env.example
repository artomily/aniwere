# Creditcoin CC3 Testnet
# Terverifikasi 27 Agustus 2026. Lihat docs/ATTESTCOIN.md bagian 5.
CREDITCOIN_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031

# Wallet deployer. JANGAN commit file .env yang sudah terisi.
PRIVATE_KEY=

# Block Prover Precompile. Tidak punya bytecode, jadi jangan pernah
# memvalidasinya dengan address.code.length > 0.
ATTESTCOIN_PROVER=0x0000000000000000000000000000000000000FD2

# Chain Info Precompile. Dipakai worker untuk menunggu attestation.
ATTESTCOIN_CHAIN_INFO=0x0000000000000000000000000000000000000FD3

# Identifier Sepolia di jaringan Creditcoin.
# INI BUKAN chain ID. Chain ID Sepolia 11155111, chain key-nya 1.
SOURCE_CHAIN_KEY=1

# Hasil deploy dari contracts-sepolia
SOURCE_PROBE_SEPOLIA=

# Harus identik dengan yang dipakai AniWereProbe
AAVE_POOL_SEPOLIA=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
